# .env.local  — copy this to .env.local and adjust for your network.

# Where the backend (trackeye-central) is reachable FROM THE BROWSER.
# Same PC while testing:
NEXT_PUBLIC_API_URL=http://localhost:8080
# On your LAN, use the server PC's IP so other machines' browsers can reach it:
# NEXT_PUBLIC_API_URL=http://192.168.1.50:8080

# The address this Next.js app is served on.
NEXTAUTH_URL=http://localhost:3000
# On your LAN:
# NEXTAUTH_URL=http://192.168.1.50:3000

# REQUIRED: a real random secret (the old value "your-secret-key-here" is unsafe).
# Generate your own with:  openssl rand -base64 32
NEXTAUTH_SECRET=wQdFKkqW+PLTIA6FhRdFxCLUyW4hZpEbP8cFR7BURPg=

# ---------------------------------------------------------------------------
# Remember: because the browser calls the backend directly (cross-origin), the
# backend must allow this app's origin in CORS. In trackeye-central's
# application-dev.yml set:
#   app.frontend-origins=http://localhost:3000,http://192.168.1.50:3000
# ---------------------------------------------------------------------------
